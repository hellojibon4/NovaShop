# Vite Firebase Configuration (Frontend)
# https://console.firebase.google.com/ থেকে এই তথ্যগুলি সংগ্রহ করুন
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Legacy React App environment variable fallbacks
REACT_APP_FIREBASE_API_KEY=your_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
REACT_APP_FIREBASE_PROJECT_ID=your_project_id_here
REACT_APP_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
REACT_APP_FIREBASE_APP_ID=your_app_id_here

# Stripe Configuration
# https://dashboard.stripe.com থেকে এই তথ্যগুলি পান
REACT_APP_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# SendGrid Configuration
# https://sendgrid.com থেকে API Key পান
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Backend URL (যদি আলাদা backend থাকে)
REACT_APP_API_URL=http://localhost:5000

# Admin Email (যেখানে অর্ডার এবং মেসেজ পাঠানো হবে)
ADMIN_EMAIL=your-email@gmail.com

# Node Environment
NODE_ENV=development
